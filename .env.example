# Clé API Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# FALSE = API Gemini (AI Studio) ; TRUE = Vertex AI (nécessite GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION)
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# Modèle utilisé par Ale
ALE_MODEL=gemini-3.5-flash
# Dossier des bases SQLite (sessions, mémoire, chevaux, lieux)
ALE_DATA_DIR=data
